generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Roles
enum Role {
  SUPER_ADMIN
  ADMIN
}

// 2. Notice Categories for College Noticeboard
enum NoticeCategory {
  GENERAL
  ACADEMIC
  ADMISSION
  EXAM
  EVENT
}

// 3. User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relation: One User can create Many Notices
  notices Notice[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// 4. Notice Model
model Notice {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  content     String         @db.Text
  category    NoticeCategory @default(GENERAL)
  attachment  String?
  isFeatured  Boolean        @default(false) @map("is_featured")
  isDeleted   Boolean        @default(false) @map("is_deleted")
  publishedAt DateTime       @default(now()) @map("published_at")
  authorId    String         @map("author_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relation: Notice belongs to an Author (User)
  author User @relation(fields: [authorId], references: [id])

  @@index([category])
  @@index([isFeatured])
  @@index([isDeleted])
  @@map("notices")
}
