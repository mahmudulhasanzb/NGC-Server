generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Roles
enum Role {
  SUPER_ADMIN
  ADMIN
}

// 2. Notice Categories
enum NoticeCategory {
  GENERAL
  ACADEMIC
  ADMISSION
  EXAM
  EVENT
}

// 3. User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relation: User -> Notices
  notices Notice[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// 4. Notice Model
model Notice {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  content     String         @db.Text
  category    NoticeCategory @default(GENERAL)
  attachment  String?
  isFeatured  Boolean        @default(false) @map("is_featured")
  isDeleted   Boolean        @default(false) @map("is_deleted")
  publishedAt DateTime       @default(now()) @map("published_at")
  authorId    String         @map("author_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([category])
  @@index([isFeatured])
  @@index([isDeleted])
  @@map("notices")
}

// 5. Teacher / Faculty Model
model Teacher {
  id            String   @id @default(uuid())
  name          String
  designation   String
  department    String
  qualification String
  email         String?
  phone         String?
  photoUrl      String?  @map("photo_url")
  bio           String?  @db.Text
  orderIndex    Int      @default(0) @map("order_index")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([department])
  @@index([isDeleted])
  @@map("teachers")
}

// 6. Gallery / Moments Model (Best Photos)
model GalleryItem {
  id         String   @id @default(uuid())
  title      String
  imageUrl   String   @map("image_url")
  caption    String?
  category   String?
  isFeatured Boolean  @default(false) @map("is_featured")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isFeatured])
  @@index([isDeleted])
  @@map("gallery_items")
}

// 7. College Stats Model
model CollegeStat {
  id         String   @id @default(uuid())
  label      String
  value      String
  icon       String?
  orderIndex Int      @default(0) @map("order_index")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isDeleted])
  @@map("college_stats")
}
