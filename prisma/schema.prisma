generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Roles
enum Role {
  SUPER_ADMIN
  ADMIN
}

// 2. Notice Categories
enum NoticeCategory {
  GENERAL
  ACADEMIC
  ADMISSION
  EXAM
  EVENT
}

// 3. User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relation: User -> Notices
  notices Notice[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// 4. Notice Model
model Notice {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  content     String         @db.Text
  category    NoticeCategory @default(GENERAL)
  attachment  String?
  isFeatured  Boolean        @default(false) @map("is_featured")
  isDeleted   Boolean        @default(false) @map("is_deleted")
  publishedAt DateTime       @default(now()) @map("published_at")
  authorId    String         @map("author_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([category])
  @@index([isFeatured])
  @@index([isDeleted])
  @@map("notices")
}

// 5. Teacher / Faculty Model
model Teacher {
  id               String   @id @default(uuid())
  name             String
  designation      String
  department       String
  qualification    String
  email            String?
  phone            String?
  photoUrl         String?  @map("photo_url")
  bio              String?  @db.Text
  presentAddress   String?  @map("present_address")
  permanentAddress String?  @map("permanent_address")
  mpoIndexNo       String?  @map("mpo_index_no")
  joiningDate      String?  @map("joining_date")
  experience       String?
  interest         String?
  orderIndex       Int      @default(0) @map("order_index")
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([department])
  @@index([isDeleted])
  @@map("teachers")
}

// 6. Gallery / Moments Model (Best Photos)
model GalleryItem {
  id         String   @id @default(uuid())
  title      String
  imageUrl   String   @map("image_url")
  caption    String?
  category   String?
  isFeatured Boolean  @default(false) @map("is_featured")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isFeatured])
  @@index([isDeleted])
  @@map("gallery_items")
}

// 7. College Stats Model
model CollegeStat {
  id          String   @id @default(uuid())
  label       String
  value       String
  icon        String?
  description String?
  orderIndex  Int      @default(0) @map("order_index")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isDeleted])
  @@map("college_stats")
}

// 8. College About Model
model CollegeAbout {
  id              String   @id @default(uuid())
  heading         String   @default("40+ Years of Academic Excellence in Nabiganj")
  subheading      String   @default("Empowering generations through quality education, discipline, and integrity since 1984.")
  description1    String   @db.Text
  description2    String   @db.Text
  videoEmbedUrl   String   @map("video_embed_url")
  videoThumbnail  String?  @map("video_thumbnail")
  missionText     String   @db.Text @map("mission_text")
  visionText      String   @db.Text @map("vision_text")
  valuesText      String   @db.Text @map("values_text")
  establishedYear String   @default("1984") @map("established_year")
  eiinNumber      String   @default("129524") @map("eiin_number")
  collegeCode     String   @default("1301") @map("college_code")
  nuCode          String   @default("1706") @map("nu_code")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("college_about")
}

// 9. Better-Auth Compatible Models
model BetterUser {
  id            String          @id
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  role          String?         @default("admin")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      BetterSession[]
  accounts      BetterAccount[]

  @@map("user")
}

model BetterSession {
  id        String     @id
  expiresAt DateTime
  token     String     @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      BetterUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("session")
}

model BetterAccount {
  id                    String     @id
  accountId             String
  providerId            String
  userId                String
  user                  BetterUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@map("account")
}

model BetterVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
